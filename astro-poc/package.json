{
  "name": "lenses-astro-migration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/sync-legacy-assets.mjs && astro dev",
